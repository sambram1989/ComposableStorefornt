#
# Import the Solr CronJob Trigger configuration for the Product Catalog
#

INSERT_UPDATE Trigger; cronJob(code)[unique = true]            ; second; minute; hour; day; month; year; relative; active; maxAcceptableDelay
# Run the full-wholescriptsProductIndex-cronJob at 3:05 AM every day
                     ; full-wholescriptsProductIndex-cronJob   ; 0     ; 5     ; 3   ; -1 ; -1   ; -1  ; false   ; false ; -1
# Run the update-wholescriptsProductIndex-cronJob every 1 minutes
                     ; update-wholescriptsProductIndex-cronJob ; 0     ; 1     ; -1  ; -1 ; -1   ; -1  ; true    ; false ; -1
