UPDATE ItemDuration;code[unique=true]  ;name
                          ;ON_GOING    ;ONGOING
                          ;AS_NEEDED   ;AS NEEDED 
                          ;WEEK_1      ;1 WEEK 
                          ;WEEK_2      ;2 WEEK 
                          ;WEEK_3      ;3 WEEK	
                          ;WEEK_4      ;4 WEEK		


UPDATE ItemType;code[unique=true]    ;name
                          ;BOTTLE    ;BOTTLE
                          ;MEDPAX    ;MEDPAX
                          ;CARTON    ;CARTON 
                          ;PACKET    ;PACKET 
                          ;PILL      ;PILL	
                          
UPDATE TimeOfTheDay;code[unique=true]    ;name
                   ;AM                   ;AM
                   ;PM                   ;PM
                   ;DAILY                ;Daily 
                   ;BEDTIME              ;Bedtime
                   ;AM_WITH_FOOD         ;AM With Food
                   ;PM_WITH_FOOD         ;PM With Food
                   ;BEDTIME_WITH_FOOD    ;Bedtime With Food
                   ;AM_WITHOUT_FOOD      ;AM Without Food
                   ;PM_WITHOUT_FOOD      ;PM Without Food
                   ;BEDTIME_WITHOUT_FOOD ;Bedtime Without Food