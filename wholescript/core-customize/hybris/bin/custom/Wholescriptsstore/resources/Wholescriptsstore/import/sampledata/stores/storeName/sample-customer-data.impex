INSERT_UPDATE SearchRestriction;code[unique=true]                               ;name[lang=en] ;restrictedType(code)  ;principal(uid)  ;active     ;generate  ;query
                               ;asm_b2bunit_practitioner_salesperson_restricted ;              ;B2BUnit               ;employeesalesrepusergroup    ;true       ;true      ;{pk} in ({{ SELECT DISTINCT {b.pk} FROM {B2BUnit AS b JOIN SapCustomerGroupEnum AS cg ON {cg.pk} = {b.sapcustomergroup}} WHERE {cg.code} = '02' AND {b.salesPerson} IN ({{ SELECT RIGHT(CONCAT('0000000000', SUBSTRING({b1.uid}, 1, CHARINDEX('_', {b1.uid}) - 1)), 10) FROM {B2BUnit AS b1 JOIN SapCustomerGroupEnum AS cg1 ON {cg1.pk} = {b1.sapcustomergroup}} WHERE {cg1.code} = '01' and {b1.salesPerson} = ?session.user.sapBusinessPartnerID }}) }})
                               ;asm_b2bcustomer_practitioner_salesperson_restricted      ;     ;B2BCustomer           ;employeesalesrepusergroup    ;true       ;true      ;{pk} in ({{ SELECT uniontable.PK FROM({{ SELECT DISTINCT {c.pk} FROM {B2BUnit AS b join B2BCustomer as c on {c.defaultB2BUnit} = {b.pk}} WHERE {b.salesPerson} = ?session.user.sapBusinessPartnerID }}UNION {{ SELECT DISTINCT {c1.pk} FROM {B2BUnit AS b1 JOIN SapCustomerGroupEnum AS cg1 ON {cg1.pk} = {b1.sapcustomergroup} join B2BCustomer as c1 on {c1.defaultB2BUnit} = {b1.pk}} WHERE {cg1.code} = '02' AND {b1.salesPerson} IN ({{ SELECT RIGHT(CONCAT('0000000000', SUBSTRING({b2.uid}, 1, CHARINDEX('_', {b2.uid}) - 1)), 10) FROM {B2BUnit AS b2 JOIN SapCustomerGroupEnum AS cg2 ON {cg2.pk} = {b2.sapcustomergroup} join B2BCustomer as c2 on {c2.defaultB2BUnit} = {b2.pk}} WHERE {cg2.code} = '01' AND {b2.salesPerson} = ?session.user.sapBusinessPartnerID }}) }}) uniontable}})




