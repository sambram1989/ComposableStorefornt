#
# Import the BaseStore
#

# Language
$lang=en
$storeUid=wholescripts

# Create Base Store
UPDATE BaseStore;uid[unique=true];name[lang=$lang];pickupInStoreMode(code)
                ;$storeUid;wholescripts;BUY_AND_COLLECT