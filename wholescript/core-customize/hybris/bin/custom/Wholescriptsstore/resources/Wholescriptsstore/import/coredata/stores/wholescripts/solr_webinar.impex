                                 ; $solrIndexedType                          ; shortDescription   ; string    ;                   ;                          ; true                      ;                            ;                                     ;                                    ; springELValueProvider             ; getShortDescription(#lang) ;                                ;                    ;                          ;              ;                               ;                   ;                                  ;                                              ;                      ;
