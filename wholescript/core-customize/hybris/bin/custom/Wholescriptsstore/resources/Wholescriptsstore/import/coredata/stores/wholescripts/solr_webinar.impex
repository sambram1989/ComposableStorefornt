                                 ; $solrIndexedType                          ; videoImageUrl      ; string    ;                   ;                          ;                           ;                            ;                                     ;                                    ; webinarVideoImageUrlValueProvider ;                            ;                                ;                    ; true                     ; 100          ;                               ;                   ; true                             ; POSTFIX                                      ; 50                   ; 3
