# Other facet properties          
INSERT_UPDATE SolrIndexedProperty ; solrIndexedType(identifier)[unique=true] ; name[unique=true] ; type(code) ; sortableType(code) ; currency[default=false] ; localized[default=false] ; multiValue[default=false] ; facet[default=true] ; facetType(code) ; facetSort(code) ; priority ; visible ; useForSpellchecking[default=false] ; useForAutocomplete[default=false] ; fieldValueProvider                ; facetDisplayNameProvider ;  
                                  ; $solrIndexedType                         ; webinarTag        ; string     ;                    ;                         ; true                     ; true                      ; true                ; MultiSelectOr   ; Alpha           ; 9000     ; true    ;                                    ;                                   ; webinarCatgeoryTagValueProvider   ;                          ;  
                                  ; $solrIndexedType                         ; presenterCode     ; string     ;                    ;                         ; true                     ; true                      ; true                ; MultiSelectOr   ; Custom          ; 8000     ; true    ;                                    ;                                   ; webinarPresenterCodeValueProvider ;                          ;
                                  ; $solrIndexedType                         ; duration          ; string     ;                    ;                         ;                          ;                           ; true                ;                 ; Custom          ; 8000     ; true    ;                                    ;                                   ; springELValueProvider             ;                          ;
                                  ; $solrIndexedType                         ; webinarStatus       ; string     ;                	;					 ;                         ;  true                        ; true                        ;   MultiSelectOr                     ; Alpha          ; 10000    ; true     ;                                    ;                                   ; webinarWebinarStatusProvider           ;                           			;



# Create the queries that will be used to extract data for Solr
INSERT_UPDATE SolrIndexerQuery ; solrIndexedType(identifier)[unique=true] ; identifier[unique=true]                   ; type(code) ; injectCurrentDate[default=true] ; injectCurrentTime[default=true] ; injectLastIndexTime[default=true] ; query                                                               ; user(uid)
                               ; $solrIndexedType                         ; $searchIndexNamePrefix-webinarFullQuery   ; full       ;                                 ;                                 ; false                             ; "SELECT {PK} FROM {Webinar as w join VideoStatus as vs on {w.videostatus}={vs.pk}} WHERE {vs.code}='PUBLISHED'"                                        ; admin
                               ; $solrIndexedType                         ; $searchIndexNamePrefix-webinarUpdateQuery ; update     ;                                 ;                                 ;                                   ; "SELECT {PK} FROM {Webinar as w join VideoStatus as vs on {w.videostatus}={vs.pk}} WHERE {modifiedtime} >= ?lastIndexTime AND {vs.code}='PUBLISHED' " ; admin

# Search query template        
INSERT_UPDATE SolrSearchQueryTemplate ; name[unique=true] ; indexedType(identifier)[unique=true] ; ftsQueryBuilder             ; enableHighlighting[default=true]
                                      ; DEFAULT           ; $solrIndexedType                     ; defaultFreeTextQueryBuilder ;                                 

# facet search query properties       
INSERT_UPDATE SolrSearchQueryProperty ; indexedProperty(name, solrIndexedType(identifier))[unique=true] ; facet[default=true] ; facetType(code) ; priority ; facetDisplayNameProvider ; facetSortProvider ; facetTopValuesProvider ; includeInResponse[default=true] ; searchQueryTemplate(name, indexedType(identifier))[unique=true][default=DEFAULT:$solrIndexedType]
                                      ; duration:$solrIndexedType                                       ;                     ; MultiSelectOr   ; 1000    ;                          ;                   ;                        ;                                 ;
                                      ; presenterCode:$solrIndexedType                                  ;                     ; MultiSelectOr   ; 2000    ;                          ;                   ;                        ;                                 ;
                                      ; webinarTag:$solrIndexedType                                     ;                     ; MultiSelectOr   ; 3000     ;                          ;                   ;                        ;                                 ;
                                      ; webinarStatus:$solrIndexedType                            		;                     ; MultiSelectOr   ; 4000     ;  	;     ;  ;                                 ;


INSERT_UPDATE SolrIndexerCronJob ; code[unique = true]                     ; job(code)      ; singleExecutable ; sessionLanguage(isocode) ; active ; facetSearchConfig(name) ; indexerOperation(code)
                                 ; full-wholescriptsWebinarIndex-cronJob   ; solrIndexerJob ; false            ; en                       ; true   ; $facetSearchConfigName  ; full                  
                                 ; update-wholescriptsWebinarIndex-cronJob ; solrIndexerJob ; false            ; en                       ; true   ; $facetSearchConfigName  ; update


# Non-facet search query properties
INSERT_UPDATE SolrSearchQueryProperty ; indexedProperty(name, solrIndexedType(identifier))[unique=true] ; searchQueryTemplate(name, indexedType(identifier))[unique=true][default=DEFAULT:$solrIndexedType] ; facet ; ftsPhraseQuery[default=false] ; ftsPhraseQueryBoost ; ftsQuery[default=false] ; ftsQueryBoost ; ftsFuzzyQuery[default=false] ; ftsFuzzyQueryFuzziness ; ftsFuzzyQueryBoost ; ftsWildcardQuery[default=false] ; ftsWildcardQueryType(code)[default=POSTFIX] ; ftsWildcardQueryBoost ; ftsWildcardQueryMinTermLength ; includeInResponse[default=true] ; useForHighlighting[default=false]
                                      ; title:$solrIndexedType                                    ;                                                                                                   ;       ; TRUE                          ; 90                  ; TRUE                    ; 90            ; TRUE                         ;                        ; 45                 ;                                 ; POSTFIX                                     ;                       ; 3                             ;                                 ;
                                      ; presenterName:$solrIndexedType                                           ;                                                                                                   ;       ; TRUE                          ; 100                 ; TRUE                    ; 100           ; TRUE                         ;                        ; 50                 ; TRUE                            ; POSTFIX                                     ; 25                    ;                               ;                                 ; true
