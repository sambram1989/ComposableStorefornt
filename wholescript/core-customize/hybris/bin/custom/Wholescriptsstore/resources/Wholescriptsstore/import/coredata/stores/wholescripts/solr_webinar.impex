$facetSearchConfigName=wholescriptsWebinarIndex
$facetSearchConfigDescription=wholescripts Webinar Index
$searchIndexNamePrefix=wholescripts
$solrIndexedType=wholescriptsWebinarType
$indexBaseSite=wholescripts
$indexStandaloneBaseSite=wholescripts-standalone
$indexLanguages=en
$indexCurrencies=USD

# Setup the indexed types, their properties, and the update queries
#

# Declare the indexed type Product

# Define the available sorts   
INSERT_UPDATE SolrSort ; &sortRefID ; indexedType(identifier)[unique=true] ; code[unique=true] ; useBoost
                       ; sortRef1   ; $solrIndexedType                     ; newest            ; true    
                       ; sortRef2   ; $solrIndexedType                     ; oldest            ; false   
                       ; sortRef3   ; $solrIndexedType                     ; popular           ; false   

# Define the sort fields
INSERT_UPDATE SolrSortField ; sort(indexedType(identifier),code)[unique=true] ; fieldName[unique=true] ; ascending[unique=true]
                            ; $solrIndexedType:newest                  ; publishedDate           ; true
                            ; $solrIndexedType:oldest                         ; publishedDate           ; false
                            ; $solrIndexedType:popular                        ; polularRank                  ; false

INSERT_UPDATE SolrIndexedType ; identifier[unique=true] ; type(code) ; variant ; sorts(&sortRefID)         
                              ; $solrIndexedType        ; Webinar    ; false   ; sortRef1,sortRef2,sortRef3
                              
                              
INSERT_UPDATE SolrFacetSearchConfig ; name[unique=true]      ; description                   ; indexNamePrefix        ; languages(isocode) ; currencies(isocode)[append=true] ; solrServerConfig(name) ; solrSearchConfig(description) ; solrIndexConfig(name) ; solrIndexedTypes(identifier) ; enabledLanguageFallbackMechanism ;  
                                    ; $facetSearchConfigName ; $facetSearchConfigDescription ; $searchIndexNamePrefix ; $indexLanguages    ; $indexCurrencies                 ; Default                ; Default                       ; Default               ; $solrIndexedType             ; true                             ;  

