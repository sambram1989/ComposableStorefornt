# ImpEx for Importing Categories

# Macros / Replacement Parameter definitions
$productCatalog = catalog_1710_10_ProductCatalog
$productCatalogName = Product Catalog for 1710_10
$catalogVersion = catalogversion(catalog(id[default = $productCatalog]), version[default = 'Staged'])[unique = true, default = $productCatalog:Staged]
$superCategories = superCategories(code, $catalogVersion)

##locallization
# Language
$lang = en

UPDATE Category; $catalogVersion; code[unique = true]; name[lang = $lang]; description[lang = $lang]
               ;                ; brands             ; Brands            ; Brands   ;
               ;                ; xymogen            ; Xymogen           ; Xymogen  ;
               ;                ; acgrace            ; AC Grace          ; AC Grace ;
               ;                ; quicksilver        ; Quicksilver       ; Quicksilver