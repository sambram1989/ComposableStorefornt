# ImpEx for Importing Category Classifications into Wholescripts Store

# Macros / Replacement Parameter definitions
###############################localized impex
#% impex.setLocale(Locale.ENGLISH);
# Macros / Replacement Parameter definitions
$productCatalog = Default
$catalogVersion = catalogversion(catalog(id[default = $productCatalog]), version[default = 'Staged'])[unique = true, default = $productCatalog:Staged]
$clAttrModifiers = system = 'PIMClassification', version = '1.0', translator = de.hybris.platform.catalog.jalo.classification.impex.ClassificationAttributeTranslator, lang = en

$inactiveIngredients=@inactiveIngredients[$clAttrModifiers];


UPDATE Product; code[unique = true]; $inactiveIngredients; $catalogVersion
	;	000000000500070042;"<h4>Drainage</h4> <p>USP Purified water; USP Gluten-free, non-GMO, organic cane alcohol 20%.</p>"
	;	000000000300000574;"USP Purified water; USP Gluten-free, non-GMO, organic cane alcohol 20%.	"
