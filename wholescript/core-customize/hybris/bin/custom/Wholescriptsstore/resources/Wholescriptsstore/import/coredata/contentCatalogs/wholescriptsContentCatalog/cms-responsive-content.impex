# Define the Paragraph Components
INSERT_UPDATE CMSParagraphComponent; $contentCV[unique = true]; uid[unique = true]                ; name                                                      ; &componentRef                     ; content
#TopBannerSlot
                                   ;                          ; resellingPageParagraphComponent1  ; Reselling Page Paragraph1 Component for ResellCardsSlot   ; resellingPageParagraphComponent1  ; "RESELLING"
#ResellCardsSlot
                                   ;                          ; resellingPageParagraphComponent2  ; Reselling Page Paragraph1 Component for ResellCardsSlot   ; resellingPageParagraphComponent2  ; "<h2>Definition of reselling</h2><p>When a legitimate retailer or purchaser buys products to either resell or use as component parts of products it plans to resell. Drop-Ship customers are resellers as well. A Drop-Ship customer is a practitioner that purchases products on our platform at wholesale and then has WholeScripts send those products directly to their patient.</p>"
                                   ;                          ; resellingPageParagraphComponent3  ; Reselling Page Paragraph2 Component for ResellCardsSlot   ; resellingPageParagraphComponent3  ; "<h2>Who is eligible?</h2><p>A business that is registered for sales and use tax (usually identified by its state tax ID/sales permit, which is different from a federal employer identification number FEIN) can request a resale certificate (also sometimes called a sales tax exemption certificate), from the state or states it will be delivering products to.</p>"
                                   ;                          ; resellingPageParagraphComponent4  ; Reselling Page Paragraph3 Component for ResellCardsSlot   ; resellingPageParagraphComponent4  ; "<h2>Why we need your resale/tax exempt certificate(s)</h2><p>If you do not upload a copy of your resale certificate, you will be charged tax on all WholeScripts orders. We will verify your resale or sales tax exemption certificate to make sure we are in accordance with all state and federal laws.</p>"
#ResellAvalaraSlot
                                   ;                          ; resellingPageParagraphComponent5  ; Reselling Page Paragraph1 Component for ResellCardsSlot   ; resellingPageParagraphComponent5  ; "Ready to start reselling? Head over to Avalara to get started."
                                   ;                          ; resellingPageParagraphComponent6  ; Reselling Page Paragraph2 Component for ResellCardsSlot   ; resellingPageParagraphComponent6  ; "<div><b>Please note:</b> Your resale certificate(s) must contain the same information that is on your account.</div>"
                                   ;                          ; resellingPageParagraphComponent7  ; Reselling Page Paragraph3 Component for ResellCardsSlot   ; resellingPageParagraphComponent7  ; "<div><b>Please note:</b> The review process for submitted certificate(s) takes approximately <b>3 to 5 business days.</b> Once validated, you will no longer pay sales tax from the effective date of the certificate when shipping to the applicable states.</div>"
#ResellProcessSlot
                                   ;                          ; resellingPageParagraphComponent8  ; Reselling Page Paragraph1 Component for ResellProcessSlot ; resellingPageParagraphComponent84 ; "WHAT'S THE PROCESS?"
                                   ;                          ; resellingPageParagraphComponent9  ; Reselling Page Paragraph2 Component for ResellProcessSlot ; resellingPageParagraphComponent94 ; "Fill in your business information"
                                   ;                          ; resellingPageParagraphComponent10 ; Reselling Page Paragraph3 Component for ResellProcessSlot ; resellingPageParagraphComponent10 ; "Upload your resale certificate(s) for each state you want to deliver to"
                                   ;                          ; resellingPageParagraphComponent11 ; Reselling Page Paragraph4 Component for ResellProcessSlot ; resellingPageParagraphComponent11 ; "Get verified. Save on taxes!"

