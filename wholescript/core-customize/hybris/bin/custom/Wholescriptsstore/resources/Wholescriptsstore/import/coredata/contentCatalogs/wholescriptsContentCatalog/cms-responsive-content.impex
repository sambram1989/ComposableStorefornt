#
# Import the CMS content for the site
#
$contentCatalog = wholescriptsContentCatalog
$contentCV = catalogVersion(CatalogVersion.catalog(Catalog.id[default = $contentCatalog]), CatalogVersion.version[default = Staged])[default = $contentCatalog:Staged]
#$siteResource=jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/sampledata/productCatalogs/catalogName
$siteResourceDASHBOARD = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/coredata/images/Dashboard
$medias = medias(code, $contentCV);
$mediaContainer = media(qualifier, $contentCV)[lang = $lang];
# Language
$lang = en
$siteResource = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/sampledata/productCatalogs/catalogName
$siteHomepageResource = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/coredata/images/Homepage
$siteResourceguestShopPage = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/coredata/images/guestShopPage
$picture = media(code, $contentCV)
$siteResource = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/coredata/images
$siteintegrationsPagePage = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/coredata/images/integrationsPage
$siteProductDetailsPage = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/coredata/images/wsProductDetailsPage
$siteCartPage = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/coredata/images/CartPage

$siteMagazinePage = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/coredata/images/magazinePage
$siteResourceMagazinePagePdfDocuments = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/coredata/PdfDocuments

$lang = en


# Import config properties into impex macros
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$jarResourceCms = $config-jarResourceCmsValue

## Changing default OOTB homepage ###
