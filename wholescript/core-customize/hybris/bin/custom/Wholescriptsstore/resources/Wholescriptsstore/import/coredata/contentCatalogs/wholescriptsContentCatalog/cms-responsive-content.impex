UPDATE CMSParagraphComponent; $contentCV[unique = true]; uid[unique = true]                       ; content[lang = $lang]
                            ;                          ; GeneticspageHeadingSectionParaComponent  ; "<h2>Personalized Recommendations Backed By Science</h2><p>You can now offer clinical lab testing, practitioner-grade supplements, your services, and more with shipping, fulfillment, and logistics all done for you in a single platform.</p><hr/>"
                            ;                          ; GeneticsBodyContentSection1ParaComponent ; "<h3>How to Get Started</h3><p>Suggest products based on your lab test results:</p><ol><li><strong>Visit <a href='https://3x4genetics.com/'>3x4 Genetics</a> to start sending lab tests to your patients or clients.</strong></li><li><strong>If you work with patients, sign up for our Patient Direct program:</strong><br/>Log in to WholeScripts and visit our <a href='/patient-direct-hub'>Patient Direct sign-up page</a> to recommend supplements that align with your patient’s lab test results.</li></ol><hr/><h3>Resources & Support</h3><ul><li><a href='https://3x4genetics.com/'>Visit 3x4 Genetics</a> to learn about its services.</li></ul>"


