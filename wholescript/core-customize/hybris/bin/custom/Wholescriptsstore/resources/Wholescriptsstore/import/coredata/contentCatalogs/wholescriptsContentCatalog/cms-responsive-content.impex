                         ;                          ; Section5Slot-TCPage ; section5 Slot ; true  ; DisclaimerOfWarrantiesParagraph,CertificationParagraph



INSERT_UPDATE CMSParagraphComponent; $contentCV[unique = true]; uid[unique = true]              ; name                                         ; content
                                   ;                          ; TermsAndConditionsParagraph     ; Terms & Conditions Paragraph Component       ; "<h1>WholeScripts<sup>®</sup> Terms & Conditions</h1>"
                                   ;                          ; BodyParagraphComponent          ; Body Paragraph Component                     ; "<p>By visiting and/or shopping at (“Using”) this website, you, the individual presently Using this website (“you”), are agreeing to, and accepting, the following Terms and Conditions (“Terms”), which may be updated from time to time. Please read the Terms carefully; and contact one of our dedicated Customer Service Representatives (“CSR”) with any questions.</p>"
                                   ;                          ; LimitationsParagraphComponent   ; Limitations Paragraph Component              ; "<h4>LIMITATIONS ON ORDERS</h4> <p>Wholescripts reserves the right to discontinue sales to you at any time.</p>"
                                   ;                          ; CancellationParagraph           ; Cancellation Paragraph Component             ; "<h4>CANCELLATIONS & CHANGES</h4> <p>Order fulfillment is <b>automatic</b> and <b>immediate</b>. Therefore, it is not possible for WholeScripts to cancel or change the details of your WholeScripts order once it has been placed.</p>"
                                   ;                          ; ShippingParagraph1              ; Shipping Paragraph1 Component                ; "<h4>SHIPPING</h4> <p>WholeScripts.com will attempt to validate your shipping address; and, when possible, it may provide a recommended substitution. If a shipping vendor identifies one (1) or more errors with your shipping address, and/or the address is deemed undeliverable, you <b>will</b> be assessed an address correction and/or package rerouting fee that is subject to carrier rate adjustments based on distance between the initial delivery address and the updated delivery address, starting at twenty-one dollars ($21.00 USD) per each WholeScripts order. Where this occurs a customer service representative will seek approval of the carrier rate adjustment to be charged to the card used to place the subject order.</p>"
                                   ;                          ; ShippingParagraph2              ; Shipping Paragraph2 Component                ; "<p>Free shipping for qualifying orders. Incomplete orders, including, but not limited to, incomplete orders combining dietary supplement and prescription orders, may be subject to a five-dollar ($5.00) handling fee, standard shipping rates, and/or delays.</p>"
                                   ;                          ; ShippingParagraph3              ; Shipping Paragraph3 Component                ; "<p>Standard Shipping is typically USPS First Class, USPS Priority, or UPS Ground; however, a different method may be utilized at WholeScripts’ sole discretion. Standard Shipping is offered to the forty-eight (48) contiguous United States only. Alaska and Hawaii, as well as Puerto Rico and the U.S. Virgin Islands, are <b>excluded</b> from Standard Shipping. You are solely responsible for any additional shipping service charges, which may include, but are not limited to, signature requirements and certificates of delivery, imposed by a  mail carrier at the mail carrier’s posted rate. <br><br>WholeScripts does not currently offer international shipping.</p>"
                                   ;                          ; ShippingRatesParagraph          ; Shipping Rates Paragraph Component           ; "<h4>SHIPPING RATES</h4>"
                                   ;                          ; PatientsPractitionersParagraph  ; Patients Practitioners Paragraph Component   ; "<div class='terms-wz-table-container'><table class='w-100 terms-wz-table'><tbody><tr><th rowspan='3' class='row-header bolder'>For Patients</th><th colspan='2' class='col-header'>Orders Placed Online, via Email or Phone</th></tr><tr><td colspan='2'>Free Standard Shipping on orders $100 or more</td></tr><tr><td colspan='2'>$11.95 Standard Shipping on orders $99.99 or less</td></tr><tr><th rowspan='7' class='row-header practitioners-row bolder'>For Practitioners</th><th class='col-header'>Orders Placed Online</th></tr><tr><td>Free Standard Shipping on orders $300 or more</td></tr><tr><td>$11.95 Standard Shipping on orders $299.99 or less</td></tr><tr><th class='col-header'>Orders Placed via Email or Phone</th></tr><tr><td>Free Standard Shipping on orders $300 or more</td></tr><tr><td>$11.95 Standard Shipping on orders between $100 and $299.99</td></tr><tr><td>$14.95 Standard Shipping on orders $99.99 or less</td></tr></tbody></table></div>"
                                   ;                          ; ReturnPolicyParagraph           ; Return Policy Paragraph Component            ; "<h4>RETURN POLICY</h4> <p>WholeScripts <b>does not accept returns</b> but for extenuating circumstances, including shortages, damages, and incorrect items. Claims must be made within five (5) days of delivery. WholeScripts does not resell returned items.</p>"
                                   ;                          ; NotForResalePolicyParagraph     ; Not For Resale Policy Paragraph Component    ; "<h4>NOT FOR RESALE POLICY</h4> <p>YOU ARE <b>PROHIBITED</b> FROM RESELLING THE PRODUCTS PURCHASED AND/OR OBTAINED FROM THIS WEBSITE, WHICH INCLUDES XYMOGEN-BRANDED PRODUCTS AND THIRD-PARTY PRODUCTS (“PRODUCTS”), REGARDLESS OF WHETHER SUCH PRODUCTS WERE PURCHASED AND/OR OBTAINED AT (1) FULL PRICE, (2) A DISCOUNTED PRICE, AND/OR (3) FREE OF CHARGE. FURTHERMORE, IT IS A BREACH OF THESE TERMS TO MARKET, ADVERTISE, AND/OR DISTRIBUTE FOR RESALE, AND/OR OTHERWISE CAUSE TO BE MARKETED, ADVERTISED, AND/OR DISTRIBUTED FOR RESALE, THE PRODUCTS MADE AVAILABLE TO YOU ON THIS WEBSITE.</p>"
                                   ;                          ; CopyRightsParagraph             ; Copy Rights Paragraph Component              ; "<h4>COPYRIGHT NOTICE</h4> <p>All the content, separately and together, that is included on this website, which includes, but is not limited to, text, graphics, logos, button icons, images, audio clips, digital downloads, data compilations, and software, is the exclusive property of this website's owner or its content suppliers. Additionally, the Content is protected by the copyright laws of the United States and of the international community. WholeScripts reserves the right to enforce its statutory rights to recover damages against you for any copyright infringements.</p>"
                                   ;                          ; DisclaimerOfWarrantiesParagraph ; Disclaimer Of Warranties Paragraph Component ; "<h4>DISCLAIMER OF WARRANTIES AND LIMITATION OF LIABILITY</h4> <p>THIS WEBSITE IS PROVIDED ON AN ""AS IS"" AND ""AS AVAILABLE"" BASIS. NO REPRESENTATIONS OR WARRANTIES OF ANY KIND ARE MADE, EXPRESS OR IMPLIED, AS TO THE OPERATION OF THIS WEBSITE OR THE INFORMATION, CONTENT, MATERIALS, OR PRODUCTS INCLUDED ON THIS WEBSITE. YOU EXPRESSLY AGREE THAT YOUR USE OF THIS WEBSITE IS AT YOUR SOLE RISK. TO THE FULL EXTENT PERMISSIBLE BY APPLICABLE LAW, THIS WEBSITE'S OWNER DISCLAIMS ALL WARRANTIES, EXPRESS OR IMPLIED, INCLUDING, BUT NOT LIMITED TO, IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE. THIS WEBSITE'S OWNER DOES NOT WARRANT THAT THIS WEBSITE, ITS SERVERS, OR THE E-MAILS SENT FROM THIS WEBSITE ARE FREE OF VIRUSES AND/OR OTHER HARMFUL COMPONENTS. THIS WEBSITE'S OWNER WILL NOT BE LIABLE FOR ANY DAMAGES OF ANY KIND ARISING FROM THE USE OF THIS WEBSITE, INCLUDING, BUT NOT LIMITED TO, DIRECT, INDIRECT, INCIDENTAL, PUNITIVE, AND CONSEQUENTIAL DAMAGES. CERTAIN STATE LAWS DO NOT ALLOW LIMITATIONS ON IMPLIED WARRANTIES OR THE EXCLUSION OR LIMITATION OF CERTAIN DAMAGES. IF THESE LAWS APPLY TO YOU, SOME OR ALL OF THE ABOVE DISCLAIMERS, EXCLUSIONS, OR LIMITATIONS MAY NOT APPLY TO YOU, AND YOU MIGHT HAVE ADDITIONAL RIGHTS.</p>"
                                   ;                          ; CertificationParagraph          ; Certification Paragraph Component            ; "<h4>CERTIFICATION</h4> <p>IT IS YOUR SOLE RESPONSIBILITY TO <b>REVIEW</b> AND <b>VERIFY</b> THE ACCURACY OF THE DETAILS OF YOUR WHOLESCRIPTS ORDER, INCLUDING, BUT NOT LIMITED TO, PRODUCT SELECTION AND SHIPPING METHOD, <b>BEFORE</b> IT IS PLACED.<br><br> BY PLACING AN ORDER THROUGH WHOLESCRIPTS.COM (OR OVER THE PHONE WITH A CSR), YOU ARE EXPLICITLY CERTIFYING THAT YOU HAVE REVIEWED <b>AND</b> VERIFIED THE ACCURACY OF THE DETAILS OF YOUR WHOLESCRIPTS ORDER—AND EVERYTHING IS CORRECT. FURTHERMORE, YOU ARE CERTIFYING THAT YOU ARE AWARE OF ANY BACK ORDERS.</p>"

########################## END : Terms & Conditions Page ########################################
