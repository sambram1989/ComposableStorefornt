UPDATE CMSParagraphComponent; $contentCV[unique = true]; uid[unique = true]                        ; content[lang = $lang]
                            ;                          ; OptimalDXPageHeadingSectionParaComponent  ; "<h2>Transform your patient data into actionable insights</h2><p>Manage your practice, track your patients’ blood test results, and discover patterns and trends over time with the OptimalDX FBCA software platform.</p><hr/>"
                            ;                          ; OptimalDXBodyContentSection1ParaComponent ; "<h3>How to Get Started</h3><p>Suggest products based on your lab test results:</p><ol><li><strong>Sign up for our Patient Direct program:</strong><br/>Log in to WholeScripts and visit our <a href='/patient-direct-hub'>Patient Direct sign-up page</a> to begin.</li><li><strong>Visit Optimal DX to get started:</strong><br/>Start sending lab tests to your patients or clients, and create personalized <a href='https://www.optimaldx.com/partners/xymogen'>treatment</a> plans including Xymogen supplements.</li><li><strong>Share your referral code:</strong><br/>Go to the <a href='patient-direct-hub/Referral-code'>My Dispensary page</a> to find your unique referral code or referral link. Share it with your patients to help them sign up for WholeScripts patient accounts and place orders aligned with your recommended treatment plan.</li></ol>"
                            ;                          ; OptimalDXBodyContentSection2ParaComponent ; "<h3>Resources & Support</h3><ul><li><a href='https://www.optimaldx.com/'>Visit Optimal DX</a> to learn about its services and integration process.</li></ul><hr/>"


