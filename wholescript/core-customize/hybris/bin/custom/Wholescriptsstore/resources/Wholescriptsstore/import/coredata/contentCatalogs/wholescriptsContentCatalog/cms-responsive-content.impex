UPDATE WsIntegrationContentParagraphComponent; $contentCV[unique = true]; uid[unique = true]                   ; content[lang = $lang]
                                             ;                          ; practiceBetterParagraphComponent     ; "A complete nutrition practice management platform that helps you manage your health and wellness practice like a pro."
                                             ;                          ; charmHealthParagraphComponent        ; "A customizable EMR platform that includes medical forms and charting shortcuts tailored to over 20 healthcare specialties to boost efficiency,reduce errors, and provide an intuitive experience."
                                             ;                          ; cerboParagraphComponent              ; "Specifically created for functional and integrative medicine specialists, this EHR platform, is designed to support direct pay or cash-based practices, and aims to streamline and innovate your healthcare practice."
                                             ;                          ; getHealthyParagraphComponent         ; "GetHealthy is an integrated ecommerce and marketing platform for next generation practitioners. We help practitioners grow their influence and revenue through increased engagement with their patients and followers."
                                             ;                          ; wellProZParagraphComponent           ; "For the first time ever, you can now offer clinical lab testing, practitioner grade supplements, your own services and more with shipping, fulfillment, and logistics all done-for-you in a single platform."
                                             ;                          ; shopifyParagraphComponent            ; "Shopify offers users a single view of their business and customers, and allows them to manage products and inventory, process orders and payments, ship orders, build customer relationships, and leverage analytics and reporting."
                                             ;                          ; betterHealthParagraphComponent       ; "We’ve developed a service that takes functional medicine testing results and uses algorithms created with clinical experience and research to generate recommendations for nutrient repletion via vitamins, minerals, herbs, and supplements."
#                                             ;                          ; storeByWrkoutParagraphComponent      ; "WRKOUT Store is the mobile app empowering wellness professionals to curate and recommend the products they love and trust to their clients."
                                             ;                          ; odxOptimalDXParagraphComponent       ; "Manage your practice, track your patients’ blood test results and discover patterns and trends over time with the OptimalDX FBCA software platform."
                                             ;                          ; 3x4GeneticsParagraphComponent        ; "A digital health company that is pioneering the application of genomics to improve human health and optimize everyday performance."
                                             ;                          ; cellScienceSystemsParagraphComponent ; "We specialize in developing and performing laboratory testing in immunology and cell biology supporting the personalized treatment and prevention of chronic disease."


