                                   ;                          ; CharmHealthBodyContentSection1ParaComponent ; CharmHealth Page Content Section1 Para Component ; CharmHealthBodyContentSection1ParaComponent
                                   ;                          ; CharmHealthBodyContentSection2ParaComponent ; CharmHealth Page Content Section2 Para Component ; CharmHealthBodyContentSection2ParaComponent
