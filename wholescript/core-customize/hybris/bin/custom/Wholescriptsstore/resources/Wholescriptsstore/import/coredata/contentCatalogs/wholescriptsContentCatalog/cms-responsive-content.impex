# Define the Paragraph Components
INSERT_UPDATE CMSParagraphComponent; $contentCV[unique = true]; uid[unique = true]                  ; name                                                          ; &componentRef                       ; content
#TopSlot
                                   ;                          ; practionersPageParagraphComponent1  ; Practioners Page Paragraph1 Component for TopSlot             ; practionersPageParagraphComponent1  ; "Recommend The Best Brands Your Patients Need"
                                   ;                          ; practionersPageParagraphComponent2  ; Practioners Page Paragraph2 Component for TopSlot             ; practionersPageParagraphComponent2  ; "Our platform is designed to help you support your patients and streamline your administrative process."
                                   ;                          ; practionersPageParagraphComponent3  ; Practioners Page Paragraph3 Component for TopSlot             ; practionersPageParagraphComponent3  ; "Start a Recommendation Today Get Started"
#IntroSlot
                                   ;                          ; practionersPageParagraphComponent4  ; Practioners Page Paragraph1 Component for IntroSlot           ; practionersPageParagraphComponent4  ; "Quick Sign Up. Great Growth. Valuable Savings."
                                   ;                          ; practionersPageParagraphComponent5  ; Practioners Page Paragraph2 Component for IntroSlot           ; practionersPageParagraphComponent5  ; "In just a few minutes you could be well on your way to engaging with your patients more, growing your practice, helping create more health and saving some money too. Don’t miss out."
#XymoSlot
                                   ;                          ; practionersPageParagraphComponent6  ; Practioners Page Paragraph1 Component for XymoSlot            ; practionersPageParagraphComponent6  ; "Professional Formulas"
                                   ;                          ; practionersPageParagraphComponent7  ; Practioners Page Paragraph2 Component for XymoSlot            ; practionersPageParagraphComponent7  ; "XYMOGEN's comprehensive catalog of professional-grade formulas is available through WholeScripts, registered practitioners, and authorized sites. Our restricted distribution helps control quality and our science-baked formulations will support your patients' health goals."
                                   ;                          ; practionersPageParagraphComponent8  ; Practioners Page Paragraph1 Component for XymoSlot            ; practionersPageParagraphComponent8  ; "ePV Verified"
                                   ;                          ; practionersPageParagraphComponent9  ; Practioners Page Paragraph2 Component for XymoSlot            ; practionersPageParagraphComponent9  ; "Our industry-leading electronic pedigree verification (ePV) program is like an electronic fingerprint. It ensures you that each XYMOGEN formula is authentic and that the expiration and manufacture dates are factual, giving you peace of mind so you can recommend our formulas with confidence."
#RecommendationsSlot
                                   ;                          ; practionersPageParagraphComponent10 ; Practioners Page Paragraph1 Component for RecommendationsSlot ; practionersPageParagraphComponent10 ; "Send Recommendations"
                                   ;                          ; practionersPageParagraphComponent11 ; Practioners Page Paragraph2 Component for RecommendationsSlot ; practionersPageParagraphComponent11 ; "Keeping pace with your patients’ health needs is so much less complicated with WholeScripts recommendations."
                                   ;                          ; practionersPageParagraphComponent17 ; Practioners Page Paragraph1 Component for RecommendationsSlot ; practionersPageParagraphComponent17 ; <h5>Use protocols</h5><p>Create protocols for specific health concerns and easily add them to your recommendations.</p>
                                   ;                          ; practionersPageParagraphComponent18 ; Practioners Page Paragraph2 Component for RecommendationsSlot ; practionersPageParagraphComponent18 ; <h5>Recommendations for one or all</h5><p>Spend less time on computer work. Send recommendations to a single patient or multiple patients simultaneously.</p>
                                   ;                          ; practionersPageParagraphComponent19 ; Practioners Page Paragraph1 Component for RecommendationsSlot ; practionersPageParagraphComponent19 ; <h5>Stay connected with your patients</h5><p>Send SMS text and/or email notifications to your patients so they don’t miss a recommendation.</p>

#MedPaxSlot
                                   ;                          ; practionersPageParagraphComponent12 ; Practioners Page Paragraph1 Component for MedPaxSlot          ; practionersPageParagraphComponent12 ; "Wellness In a Box"
                                   ;                          ; practionersPageParagraphComponent13 ; Practioners Page Paragraph2 Component for MedPaxSlot          ; practionersPageParagraphComponent13 ; "Lead your patients to the path of good health with the convenience of MedPax dose packs."
                                   ;                          ; practionersPageParagraphComponent14 ; Practioners Page Paragraph4 Component for MedPaxSlot          ; practionersPageParagraphComponent14 ; "Start recommending MedPax today"
#DispensarySlot
                                   ;                          ; practionersPageParagraphComponent15 ; Practioners Page Paragraph1 Component for DispensarySlot      ; practionersPageParagraphComponent15 ; "Create Your Own Digital Dispensary"
                                   ;                          ; practionersPageParagraphComponent16 ; Practioners Page Paragraph2 Component for DispensarySlot      ; practionersPageParagraphComponent16 ; "Work smarter, not harder. With a WholeScripts digital dispensary you can focus on your patients, not your inventory."
#WholehealthSlot
                                   ;                          ; WholeHealthParagraph1Component      ; Whole Health Paragraph1 Component                             ; WholeHealthParagraph1Component      ; "Whole Health Care A Whole Lot Easier"
                                   ;                          ; WholeHealthParagraph2Component      ; Whole Health Paragraph2 Component                             ; WholeHealthParagraph2Component      ; "High-quality professional, nutritional and herbal supplements all in one place. It’s just one way we make whole healthcare a whole lot easier."


