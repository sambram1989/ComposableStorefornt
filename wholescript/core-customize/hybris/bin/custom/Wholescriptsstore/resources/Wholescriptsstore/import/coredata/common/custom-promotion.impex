                                              ; y_qualifying_promotion_brands      ; brands_operator    ; 1300    ; brand selection operator       ; Select ANY brand or select ALL brands from list of qualifying brands                              ; Enum(de.hybris.platform.ruledefinitions.CollectionOperator)                          ; """CONTAINS_ANY"""          ;                         ;
