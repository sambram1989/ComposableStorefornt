$spaContentCatalog=wholescriptsContentCatalog
$contentCV=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$spaContentCatalog]),CatalogVersion.version[default=Online])[default=$spaContentCatalog:Online]
$siteResource=jar:com.wholescripts.setup.InitialDataSystemSetup&/Wholescriptsstore/import/coredata/images

INSERT_UPDATE SearchBoxComponent;$contentCV[unique=true];uid[unique=true];name;&componentRef

INSERT_UPDATE ContentSlot;$contentCV[unique=true];uid[unique=true];cmsComponents(&componentRef)

INSERT_UPDATE FooterComponent;$contentCV[unique=true];uid[unique=true];wrapAfter;showLanguageCurrency


