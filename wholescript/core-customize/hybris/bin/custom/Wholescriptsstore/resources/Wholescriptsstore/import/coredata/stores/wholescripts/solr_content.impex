                                  ; $solrIndexedType                         ; brandImage        ; string     ;                    ;                         ;                          ;                           ;                                   ;                                  ; wholescriptsBrandValueResolver       ;                        ; true                         ; 80                  ; true                    ; 40            ; true                        ; 20                 ;                                 ;                                             ; 60                    ;                              
                                  ; $solrIndexedType                         ; brandURL          ; string     ;                    ;                         ;                          ;                           ;                                   ;                                  ; wholescriptsBrandValueResolver       ;                        ;                              ;                     ;                         ;               ;                             ;                    ;                                 ;                                             ; 65                    ;                              
                                  ; $solrIndexedType                         ; brandPriority     ; string     ;                    ;                         ;                          ;                           ;                                   ;                                  ; wholescriptsBrandValueResolver       ;                        ;                              ;                     ; true                    ; 100           ;                             ;                    ; true                            ; POSTFIX                                     ; 50                    ; 3                            
                                  ; $solrIndexedType                         ; isTopBrand        ; boolean    ;                    ;                         ;                          ;                           ; false                             ; false                            ; wholescriptsBrandValueResolver       ;                        ; false                        ;                     ; false                   ; 100           ;                             ;                    ; false                           ; POSTFIX                                     ; 50                    ; 3                            
