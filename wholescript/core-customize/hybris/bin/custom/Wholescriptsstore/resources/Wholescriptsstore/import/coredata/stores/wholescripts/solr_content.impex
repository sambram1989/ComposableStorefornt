$facetSearchConfigName=wholescriptsContentIndex
$facetSearchConfigDescription=wholescripts Content Search Index
$searchIndexNamePrefix=wholescripts
$solrIndexedType=wholescriptsContentSearchType
$indexBaseSite=wholescripts
$indexStandaloneBaseSite=wholescripts-standalone
$indexLanguages=en
$indexCurrencies=USD

# Setup the indexed types, their properties, and the update queries
#

INSERT_UPDATE SolrSort ; &sortRefID ; indexedType(identifier)[unique=true] ; code[unique=true] 		; name
                       ; sortRef1   ; $solrIndexedType                     ; categoryname-asc       ;  
                       ; sortRef2   ; $solrIndexedType                     ; brandname-asc          ; 

# Define the sort fields
INSERT_UPDATE SolrSortField ; sort(indexedType(identifier),code)[unique=true] ; fieldName[unique=true] ; ascending[unique=true]
                            ; $solrIndexedType:categoryname-asc               ; name           		   ; true
                            ; $solrIndexedType:brandname-asc                  ; brandName              ; true                  
 

INSERT_UPDATE SolrIndexedType ; identifier[unique=true] ; type(code)    ; variant	; sorts(&sortRefID) 
                              ; $solrIndexedType        ; ContentSearch ; false		; sortRef1, sortRef2
                              

                           
# Create the queries that will be used to extract data for Solr
INSERT_UPDATE SolrIndexerQuery ; solrIndexedType(identifier)[unique=true] ; identifier[unique=true]                       ; type(code) ; injectCurrentDate[default=true] ; injectCurrentTime[default=true] ; injectLastIndexTime[default=true] ; query                              ; user(uid)
                               ; $solrIndexedType                         ; $searchIndexNamePrefix-contentSearchFullQuery ; full       ;                                 ;                                 ; false                             ; "SELECT {PK} FROM {ContentSearch}" ; admin    

# Search query template        
INSERT_UPDATE SolrSearchQueryTemplate ; name[unique=true] ; indexedType(identifier)[unique=true] ; ftsQueryBuilder             ; enableHighlighting[default=true]
                                      ; DEFAULT           ; $solrIndexedType                     ; defaultFreeTextQueryBuilder ;                                 
                                      
INSERT_UPDATE SolrIndexerCronJob ; code[unique = true]                     ; job(code)      ; singleExecutable ; sessionLanguage(isocode) ; active ; facetSearchConfig(name) ; indexerOperation(code)
                                 ; full-wholescriptsContentIndex-cronJob   ; solrIndexerJob ; false            ; en                       ; true   ; $facetSearchConfigName  ; full                  
                                 ; update-wholescriptsContentIndex-cronJob ; solrIndexerJob ; false            ; en                       ; true   ; $facetSearchConfigName  ; update                
                                 
                                 
INSERT_UPDATE SolrFacetSearchConfig ; name[unique=true]      ; description                   ; indexNamePrefix        ; languages(isocode) ; currencies(isocode)[append=true] ; solrServerConfig(name) ; solrSearchConfig(description) ; solrIndexConfig(name) ; solrIndexedTypes(identifier) ; enabledLanguageFallbackMechanism ;  
                                    ; $facetSearchConfigName ; $facetSearchConfigDescription ; $searchIndexNamePrefix ; $indexLanguages    ; $indexCurrencies                 ; Default                ; Default                       ; Default               ; $solrIndexedType             ; true                             ;  

