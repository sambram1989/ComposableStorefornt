                                  ; $solrIndexedType                         ; brandCode         ; string     ;                    ;                         ;                          ;                           ;                                   ;                                  ; wsBrandCodeContentValueResolver      ; code                   ;                              ;                     ; true                    ; 90            ;                             ;                    ; true                            ; POSTFIX                                     ; 100                   ; 3                            
                                  ; $solrIndexedType                         ; brandName         ; text       ; sortabletext       ;                         ; false                    ;                           ;                                   ;                                  ; wsBrandNameContentValueResolver      ; 			           ; true                         ; 100                 ; true                    ; 50            ; true                        ; 25                 ;                                 ;                                             ; 90                    ;                              
