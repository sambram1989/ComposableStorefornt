                                  ; $solrIndexedType                         ; answer            ; text       ;                    ;                         ;                          ;                           ;                                   ;                                  ; wholescriptsFaqValueResolver         ;                        ;                              ;                     ; true                    ; 100           ;                             ;                    ; true                            ; POSTFIX                                     ; 50                    ; 3                            
                                  ; $solrIndexedType                         ; code              ; string     ;                    ;                         ;                          ;                           ;                                   ;                                  ; wholescriptsCategoryValueResolver    ;                        ;                              ;                     ; true                    ; 100           ;                             ;                    ; true                            ; POSTFIX                                     ; 50                    ; 3                            
                                  ; $solrIndexedType                         ; name              ; text       ; sortabletext       ;                         ; true                     ;                           ;                                   ;                                  ; wholescriptsCategoryValueResolver    ; getName(#lang)         ;                              ;                     ; true                    ; 100           ;                             ;                    ; true                            ; POSTFIX                                     ; 50                    ; 3                            
                                  ; $solrIndexedType                         ; thumbnail         ; string     ;                    ;                         ;                          ;                           ;                                   ;                                  ; wholescriptsCategoryValueResolver    ;                        ;                              ;                     ; true                    ; 100           ;                             ;                    ; true                            ; POSTFIX                                     ; 50                    ; 3                            
                                  ; $solrIndexedType                         ; picture           ; string     ;                    ;                         ;                          ;                           ;                                   ;                                  ; wholescriptsCategoryValueResolver    ;                        ;                              ;                     ; true                    ; 100           ;                             ;                    ; true                            ; POSTFIX                                     ; 50                    ; 3                            
