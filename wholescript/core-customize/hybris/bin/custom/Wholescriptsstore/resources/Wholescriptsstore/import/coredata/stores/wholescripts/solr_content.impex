                                      ; code:$solrIndexedType                                           ;                                                                                                   ;       ; TRUE                          ; 100                 ;                        ; 50            ; TRUE                        ;                        ; 25                 ;                                ;                                             ;                       ;                               ;                                 ;                                  
                                      ; name:$solrIndexedType                                           ;                                                                                                   ;       ; False                         ;                  	  ;                        ; 50            ; False                       ;                        ;                    ;                                ;                                             ;                       ;                               ;                                 ; true                             
