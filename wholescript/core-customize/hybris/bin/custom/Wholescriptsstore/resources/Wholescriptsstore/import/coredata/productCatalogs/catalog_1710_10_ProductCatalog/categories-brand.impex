$productCatalog=Default
$catalogVersion = catalogversion(catalog(id[default = $productCatalog]), version[default = 'Staged'])[unique = true, default = $productCatalog:Staged]
$supercategories=source(code, $catalogVersion)[unique=true]
$categories=target(code, $catalogVersion)[unique=true]
$logos=logo(code, $catalogVersion)
$picture=picture(code, $catalogVersion)
$siteResourceCategoryImages = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/sampledata/images/category
$lang=en
$supercategories=source(code, $catalogVersion)[unique=true]
$categories=target(code, $catalogVersion)[unique=true]
$siteResource = jar:com.wholescripts.constants.WholescriptsstoreConstants&/Wholescriptsstore/import/coredata/images

INSERT_UPDATE Category; code[unique = true]; allowedPrincipals(uid)[default = 'customergroup'];$catalogVersion
