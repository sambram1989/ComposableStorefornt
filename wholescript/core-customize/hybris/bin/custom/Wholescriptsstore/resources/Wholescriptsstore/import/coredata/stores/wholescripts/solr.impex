# Create the queries that will be used to extract data for Solr
INSERT_UPDATE SolrIndexerQuery ; solrIndexedType(identifier)[unique=true] ; identifier[unique=true]            ; type(code) ; injectCurrentDate[default=true] ; injectCurrentTime[default=true] ; injectLastIndexTime[default=true] ; query                                                                                                 ; user(uid)
                               ; $solrIndexedType                         ; $searchIndexNamePrefix-fullQuery   ; full       ;                                 ;                                 ; false                             ; "SELECT {PK} FROM {Product as p  JOIN CatalogVersion AS cv ON {p:catalogVersion} = {cv:pk}  JOIN Catalog AS c ON {cv:catalog} = {c:pk} JOIN ArticleApprovalStatus as status on {p.approvalStatus}={status.pk}} WHERE {cv:version} IN ('Online','ERP_IMPORT') AND {c:id} = 'Catalog_1710_10' AND {status.code}='approved' AND {p.code} NOT IN({{ SELECT {code} FROM {GenericVariantProduct} }}) and {p.code} NOT IN ('000000000500000030','000000000500000032') and {sapMaterialGroup} IN ({{select {pk} from {sapmaterialgroupenum} where {code} IN ('1000013','1000033','1001023','1000003','1000004','1000005','1000044','1001025')}})" ; admin
                               ; $solrIndexedType                         ; $searchIndexNamePrefix-updateQuery ; update     ;                                 ;                                 ;                                   ; "                                                                                                     
SELECT DISTINCT tbl.pk, tbl.code FROM (
	{{                            
		SELECT DISTINCT {p:PK} AS pk, {p:code} AS code
		FROM {Product AS p LEFT JOIN CustomerReview AS cr ON {cr:product}={p:PK} 
		JOIN CatalogVersion AS cv ON {p:catalogVersion} = {cv:pk}  JOIN Catalog AS c ON {cv:catalog} = {c:pk} JOIN ArticleApprovalStatus as status on {p.approvalStatus}={status.pk}}
		WHERE {cv:version} IN ('Online','ERP_IMPORT') AND {c:id} = 'Catalog_1710_10' AND {status.code}='approved' AND {p:varianttype} IS NULL AND ({p:modifiedtime} >= ?lastIndexTime OR {cr:modifiedtime} >= ?lastIndexTime) AND {p:sapMaterialGroup} IN ({{select {pk} from {sapmaterialgroupenum} where {code} IN ('1000013','1000033','1001023','1000003','1000004','1000005','1000044','1001025')}}) and {p:code} NOT IN ('000000000500000030','000000000500000032')
	}}                            
	UNION                         
	{{                            
		SELECT {p:PK}  AS pk, {p:code} AS code FROM {Product AS p JOIN CatalogVersion AS cv ON {p:catalogVersion} = {cv:pk}  JOIN Catalog AS c ON {cv:catalog} = {c:pk} JOIN ArticleApprovalStatus as status on {p.approvalStatus}={status.pk}} WHERE {p:code} IN (
			{{                          
				SELECT DISTINCT {sl:productCode} FROM {StockLevel AS sl} WHERE {sl:modifiedtime} >= ?lastIndexTime
			}}                          
		)   and {cv:version} IN ('Online','ERP_IMPORT') AND {c:id} = 'Catalog_1710_10' AND {status.code}='approved' AND {p:sapMaterialGroup} IN ({{select {pk} FROM {sapmaterialgroupenum} WHERE {code} IN ('1000013','1000033','1001023','1000003','1000004','1000005','1000044','1001025')}}) AND {p:code} NOT IN ('000000000500000030','000000000500000032')                        
	}}                            
) tbl WHERE tbl.code NOT IN({{ SELECT {code} FROM {GenericVariantProduct} }}) ORDER BY tbl.code
"                              ; admin

# Define the available sorts   
INSERT_UPDATE SolrSort ; &sortRefID ; indexedType(identifier)[unique=true] ; code[unique=true] ; useBoost ; name
                       ; sortRef1   ; $solrIndexedType                     ; bestSellers       ; true	  ; Best Sellers 
                       ; sortRef2   ; $solrIndexedType                     ; name-asc          ; true	  ; A-Z
                       ; sortRef3   ; $solrIndexedType                     ; name-desc         ; true	  ; Z-A
                       ; sortRef4   ; $solrIndexedType                     ; mapprice-asc      ; true	  ; Price: low to high
                       ; sortRef5   ; $solrIndexedType                     ; mapprice-desc     ; true	  ; Price: high to low
					   ; sortRef6   ; $solrIndexedType                     ; retailprice-asc   ; true	  ; Price: low to high
                       ; sortRef7   ; $solrIndexedType                     ; retailprice-desc  ; true	  ; Price: high to low
					   ; sortRef8   ; $solrIndexedType                     ; wsprice-asc       ; true	  ; Price: low to high
                       ; sortRef9   ; $solrIndexedType                     ; wsprice-desc      ; true	  ; Price: high to low
					   ; sortRef10  ; $solrIndexedType					   ; relevance         ; false    ;
# Define the sort fields
INSERT_UPDATE SolrSortField ; sort(indexedType(identifier),code)[unique=true] ; fieldName[unique=true] ; ascending[unique=true]
                            ; $solrIndexedType:bestSellers                    ; isBestSeller           ; false
                            ; $solrIndexedType:name-asc                       ; name               	   ; true                  
                            ; $solrIndexedType:name-desc                      ; name	               ; false                 
                            ; $solrIndexedType:mapprice-asc                   ; mapPrice               ; true                  
                            ; $solrIndexedType:mapprice-desc                  ; mapPrice               ; false                 
							; $solrIndexedType:retailprice-asc                ; retailPrice            ; true                  
                            ; $solrIndexedType:retailprice-desc               ; retailPrice            ; false                 
							; $solrIndexedType:wsprice-asc                    ; wholeSalePrice         ; true                  
                            ; $solrIndexedType:wsprice-desc                   ; wholeSalePrice         ; false                 
							; $solrIndexedType:relevance   					  ; inStockFlag			   ; false
							
