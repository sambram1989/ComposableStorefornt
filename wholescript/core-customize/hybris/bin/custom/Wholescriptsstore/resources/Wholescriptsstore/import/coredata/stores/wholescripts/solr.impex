#
# Import the Solr configuration for the store
#


$productCatalog=Catalog_1710_10
$catalogVersions=catalogVersions(catalog(id),version);
$facetSearchConfigName=wholescriptsProductIndex
$facetSearchConfigDescription=wholescripts Product Solr Index
$searchIndexNamePrefix=wholescripts
$solrIndexedType=wholescriptsProductType
$indexBaseSite=wholescripts
$indexStandaloneBaseSite=wholescripts-standalone
$indexLanguages=en
$indexCurrencies=USD

$classSystemVersion = systemVersion(catalog(id[default = 'ERP_CLASSIFICATION_001']), version[default = 'ERP_IMPORT'])
$classCatalogVersion = catalogVersion(catalog(id[default = 'ERP_CLASSIFICATION_001']), version[default = 'ERP_IMPORT'])
$classAttribute = classificationAttribute(code, $classSystemVersion)
$classClass = classificationClass(code, $classCatalogVersion)
$classAttributeAssignment = classAttributeAssignment($classClass, $classAttribute, $classSystemVersion)

$pimclassSystemVersion = systemVersion(catalog(id[default = 'PIMClassification']), version[default = '1.0'])
$pimclassCatalogVersion = catalogVersion(catalog(id[default = 'PIMClassification']), version[default = '1.0'])
$pimclassAttribute = classificationAttribute(code, $pimclassSystemVersion)
$pimclassClass = classificationClass(code, $pimclassCatalogVersion)
$pimclassAttributeAssignment = classAttributeAssignment($pimclassClass, $pimclassAttribute, $pimclassSystemVersion)


#
# Setup the indexed types, their properties, and the update queries
#

# Declare the indexed type Product
INSERT_UPDATE SolrIndexedType ; identifier[unique=true] ; type(code) ; variant ; sorts(&sortRefID)                           
                              ; $solrIndexedType        ; Product    ; false   ; sortRef1,sortRef2,sortRef3,sortRef4,sortRef5,sortRef6,sortRef7,sortRef8,sortRef9

INSERT_UPDATE SolrFacetSearchConfig ; name[unique=true]      ; description                   ; indexNamePrefix        ; languages(isocode) ; currencies(isocode)[append=true] ; solrServerConfig(name) ; solrSearchConfig(description) ; solrIndexConfig(name) ; solrIndexedTypes(identifier) ; enabledLanguageFallbackMechanism ; $catalogVersions                                 
                                    ; $facetSearchConfigName ; $facetSearchConfigDescription ; $searchIndexNamePrefix ; $indexLanguages    ; $indexCurrencies                 ; Default                ; Default                       ; Default               ; $solrIndexedType             ; true                             ; $productCatalog:Online

UPDATE BaseSite ; uid[unique=true] ; solrFacetSearchConfiguration(name)
                ; $indexBaseSite   ; $facetSearchConfigName            


