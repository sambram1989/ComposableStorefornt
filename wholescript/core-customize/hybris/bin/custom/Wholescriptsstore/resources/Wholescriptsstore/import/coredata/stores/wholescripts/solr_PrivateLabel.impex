                                      ; productCode:$solrIndexedType                                    ;                                                                                                   ;       ; FALSE                         ; 90                  ; TRUE                    ; 90            ; FALSE                        ;                        ; 45                 ; TRUE                            ; PREFIX_AND_POSTFIX                          ;                       ; 3                             ;                                 ;                                  
                                      ; name:$solrIndexedType                                           ;                                                                                                   ;       ; FALSE                         ; 100                 ; TRUE                    ; 100           ; FALSE                        ;                        ; 50                 ; TRUE                            ; POSTFIX                                     ; 25                    ;                               ;                                 ; true   
