# Create the queries that will be used to extract data for Solr
INSERT_UPDATE SolrIndexerQuery ; solrIndexedType(identifier)[unique=true] ; identifier[unique=true]                        ; type(code) ; injectCurrentDate[default=true] ; injectCurrentTime[default=true] ; injectLastIndexTime[default=true] ; query                                                                                   ; user(uid)
                               ; $solrIndexedType                         ; $searchIndexNamePrefix-privateLabelFullQuery   ; full       ;                                 ;                                 ; false                             ; "SELECT {PK} FROM { CustomerMaterialInformation as cm 
    JOIN Product AS P2 ON {cm.productCode} = TRIM(LEADING '0' FROM {P2.code}) 
    JOIN CatalogVersion AS cv ON {P2:catalogVersion} = {cv:pk} 
    JOIN Catalog AS c ON {cv:catalog} = {c:pk}}
    WHERE {cv:version} = 'Online' AND {c:id} = 'Catalog_1710_10' AND  {P2.sapMaterialGroup} IN ({{select {pk} from {sapmaterialgroupenum} where {code} IN ('1000014','1001024') }})"                                        ; admin
                               ; $solrIndexedType                         ; $searchIndexNamePrefix-privateLabelUpdateQuery ; update     ;                                 ;                                 ;                                   ; "SELECT count{PK} FROM { CustomerMaterialInformation as cm 
    JOIN Product AS P2 ON {cm.productCode} = TRIM(LEADING '0' FROM {P2.code}) 
    JOIN CatalogVersion AS cv ON {P2:catalogVersion} = {cv:pk} 
    JOIN Catalog AS c ON {cv:catalog} = {c:pk}}
    WHERE {cv:version} = 'Online' AND {c:id} = 'Catalog_1710_10' AND  {P2.sapMaterialGroup} IN ({{select {pk} from {sapmaterialgroupenum} where {code} IN ('1000014','1001024') }}) AND {modifiedtime} >= ?lastIndexTime" ; admin

# Search query template        
INSERT_UPDATE SolrSearchQueryTemplate ; name[unique=true] ; indexedType(identifier)[unique=true] ; ftsQueryBuilder             ; enableHighlighting[default=true]
                                      ; DEFAULT           ; $solrIndexedType                     ; defaultFreeTextQueryBuilder ;                                 

