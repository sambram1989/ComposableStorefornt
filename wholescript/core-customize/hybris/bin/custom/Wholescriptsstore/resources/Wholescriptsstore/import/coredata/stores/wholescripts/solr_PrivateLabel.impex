$facetSearchConfigName=wholescriptsPrivateLabelProductIndex
$facetSearchConfigDescription=wholescripts private label Product Solr Index
$searchIndexNamePrefix=wholescripts
$solrIndexedType=wholescriptsPrivateLabelProductType
$indexBaseSite=wholescripts
$indexStandaloneBaseSite=wholescripts-standalone
$indexLanguages=en
$indexCurrencies=USD

$classSystemVersion = systemVersion(catalog(id[default = 'ERP_CLASSIFICATION_001']), version[default = 'ERP_IMPORT'])
$classCatalogVersion = catalogVersion(catalog(id[default = 'ERP_CLASSIFICATION_001']), version[default = 'ERP_IMPORT'])
$classAttribute = classificationAttribute(code, $classSystemVersion)
$classClass = classificationClass(code, $classCatalogVersion)
$classAttributeAssignment = classAttributeAssignment($classClass, $classAttribute, $classSystemVersion)

$pimclassSystemVersion = systemVersion(catalog(id[default = 'PIMClassification']), version[default = '1.0'])
$pimclassCatalogVersion = catalogVersion(catalog(id[default = 'PIMClassification']), version[default = '1.0'])
$pimclassAttribute = classificationAttribute(code, $pimclassSystemVersion)
$pimclassClass = classificationClass(code, $pimclassCatalogVersion)
$pimclassAttributeAssignment = classAttributeAssignment($pimclassClass, $pimclassAttribute, $pimclassSystemVersion)

# Setup the indexed types, their properties, and the update queries
#

# Declare the indexed type Product

# Define the available sorts   
INSERT_UPDATE SolrSort ; &sortRefID ; indexedType(identifier)[unique=true] ; code[unique=true] ; useBoost ;name
                       ; sortRef3   ; $solrIndexedType                     ; name-asc          ; false   ; A-Z
                       ; sortRef4   ; $solrIndexedType                     ; name-desc         ; false   ; Z-A
                       ; sortRef5   ; $solrIndexedType                     ; price-asc         ; false   ; Price: low to high
                       ; sortRef6   ; $solrIndexedType                     ; price-desc        ; false   ; Price: high to low
                       ; sortRef7   ; $solrIndexedType                     ; bestSellers       ; true    ; Best Sellers
# Define the sort fields
INSERT_UPDATE SolrSortField ; sort(indexedType(identifier),code)[unique=true] ; fieldName[unique=true] ; ascending[unique=true]           
                            ; $solrIndexedType:name-asc                       ; productDescription	               ; true                  
                            ; $solrIndexedType:name-desc                      ; productDescription	               ; false   
                            ; $solrIndexedType:price-asc                      ; casePrice              ; true                  
                            ; $solrIndexedType:price-desc                     ; casePrice              ; false                   
                            ; $solrIndexedType:bestSellers                    ; isBestSeller           ; false
                
INSERT_UPDATE SolrIndexedType ; identifier[unique=true] ; type(code)                     ; variant ; sorts(&sortRefID)         
                              ; $solrIndexedType        ; CustomerMaterialInformation    ; false   ; sortRef7,sortRef3,sortRef4,sortRef5,sortRef6
                              
                              
INSERT_UPDATE SolrFacetSearchConfig ; name[unique=true]      ; description                   ; indexNamePrefix        ; languages(isocode) ; currencies(isocode)[append=true] ; solrServerConfig(name) ; solrSearchConfig(description) ; solrIndexConfig(name) ; solrIndexedTypes(identifier) ; enabledLanguageFallbackMechanism ;  
                                    ; $facetSearchConfigName ; $facetSearchConfigDescription ; $searchIndexNamePrefix ; $indexLanguages    ; $indexCurrencies                 ; Default                ; Default                       ; Default               ; $solrIndexedType             ; true                             ;  

