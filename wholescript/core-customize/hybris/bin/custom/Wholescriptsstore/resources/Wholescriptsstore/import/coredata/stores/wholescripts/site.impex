$spaSiteUid=wholescripts
$spaContentCatalog=wholescriptsContentCatalog
$spaContentCV=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$spaContentCatalog]),CatalogVersion.version[default=Online])[default=$spaContentCatalog:Online]
$productCatalog=Catalog_1710_10
$productCV=catalogVersion(catalog(id[default=$productCatalog]),version[default='Online'])[unique=true,default=$productCatalog:Online]

$storeUid=wholescripts
$defaultLanguage=en

$fullPathWholescripts=https://jsapps.c1lud0zblk-xymogenin1-d1-public.model-t.cc.commerce.ondemand.com/
$language=en

$urlPatterns=(?i)^https?://[^/]+(/[^?]*)?\?(.*\&)?(site=$spaSiteUid)(|\&.*)$,(?i)^https?://$spaSiteUid\.[^/]+(|/.*|\?.*)$,(?i)^https?://api\.hybrisdev\.com(:[\d]+)?/rest/.*$,(?i)^https?://localhost(:[\d]+)?/rest/.*$,(?i)^https?://[^/]+/$spaSiteUid(|/.*|\?.*|#.*)$
$urlEncodingAttributes=storefront,language,currency

### Update SiteTheme ###
INSERT_UPDATE SiteTheme; code[unique = true]; name[lang = en]
                       ; santorini          ; Santorini
                       ; sparta             ; Sparta

INSERT_UPDATE CMSSite; uid[unique = true]; stores(uid); contentCatalogs(id) ;defaultCatalog(id); defaultLanguage(isoCode); active; startingPage(uid, $spaContentCV)
                     ; $spaSiteUid       ; $storeUid  ; $spaContentCatalog  ;$productCatalog ; $defaultLanguage        ; true  ; guesthomepage
### Site for spartacus
INSERT_UPDATE CMSSite; uid[unique = true]; theme(code); channel(code); stores(uid); contentCatalogs(id); defaultLanguage(isoCode); urlPatterns  ; active; previewURL                      ; startingPage(uid, $spaContentCV); urlEncodingAttributes
                     ; $spaSiteUid       ; santorini  ; B2B          ; $storeUid  ; $spaContentCatalog ; $language               ; $urlPatterns ; true  ; $fullPathWholescripts/$spaSiteUid ; guesthomepage                   ; $urlEncodingAttributes

UPDATE CMSSite; uid[unique = true]; name[lang = $language]
              ; $spaSiteUid       ; "Wholescripts Site"

#UPDATE CMSSite;uid[unique=true];defaultPreviewCategory(code, $productCV);defaultPreviewProduct(code, $productCV);defaultPreviewCatalog(id)
#;$spaSiteUid;;$productCatalog

### Put spartacus into smart edit whitelist
INSERT_UPDATE SmartEditConfiguration; key[unique = true]     ; value
                                    ; whiteListedStorefronts ; "[""$fullPathWholescripts""]"

### Kyma OAuth client
INSERT_UPDATE OpenIDClientDetails; clientId[unique = true]; resourceIds; scope  ; autoApprove; authorizedGrantTypes                                    ; authorities ; clientSecret; registeredRedirectUri                        ; externalScopeClaimName; issuer
                                 ; client4kyma            ; hybris     ; openid ; openid     ; password,client_credentials,implicit,authorization_code ; ROLE_CLIENT ; secret      ; http://MY_APPLICATION/,http://localhost:4200 ; scope                 ; ec
